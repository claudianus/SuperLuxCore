scene.lights.f1.position = -3.63 2.78 4.9
scene.lights.f1.target = -3.50 2.78 0.0
scene.lights.f1.radius = 0.06
scene.lights.f1.gain = 900.0 900.0 900.0
scene.lights.f2.type = laser
scene.lights.f2.position = -1.84 2.78 4.9
scene.lights.f2.target = -1.75 2.78 0.0
scene.lights.f2.radius = 0.06
scene.lights.f2.gain = 900.0 900.0 900.0
scene.lights.f3.type = laser
