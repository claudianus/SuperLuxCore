# LMNEE mirror validation: a thin mirror slab, tilted 40 deg about X so
# it reflects the ceiling emitter back into the camera over the RIGHT
# half of the frame. Exercises the plain half-vector (eta == 1) branch.
scene.camera.type = "perspective"
scene.camera.lookat.orig = -2.78 -8. 2.73
scene.camera.lookat.target = -2.78 2. 2.73
scene.camera.fieldofview = 39.1463
scene.materials.Khaki.type = matte
scene.materials.Khaki.kd = 1. 0.824176 0.549451
scene.materials.HalveRed.type = matte
scene.materials.HalveRed.kd = 0.70003 0. 0.
scene.materials.DarkGreen.type = matte
scene.materials.DarkGreen.kd = 0. 0.4 0.
scene.materials.Light.type = matte
scene.materials.Light.emission = 30. 30. 30.
scene.materials.Light.emission.id = 0
scene.materials.Light.kd = 0.0 0.0 0.0
scene.materials.mirror.type = mirror
scene.materials.mirror.kr = 1.0 1.0 1.0
scene.objects.Khaki.material = Khaki
scene.objects.Khaki.ply = scenes/cornell/Khaki.ply
scene.objects.HalveRed.material = HalveRed
scene.objects.HalveRed.ply = scenes/cornell/HalveRed.ply
scene.objects.DarkGreen.material = DarkGreen
scene.objects.DarkGreen.ply = scenes/cornell/DarkGreen.ply
scene.objects.Grey.material = Light
scene.objects.Grey.ply = scenes/cornell/Grey.ply
scene.objects.slab.material = mirror
scene.objects.slab.ply = scenes/cornell/lmnee-slab.ply
# Tilt the mirror 40 deg about its centre so it reflects the ceiling
# light back toward the camera (otherwise a vertical mirror reflects
# the empty space behind the camera and the test is vacuous)
scene.objects.slab.transformation = 1.00000 0.00000 0.00000 0.00000  0.00000 0.76604 -0.64279 0.00000  0.00000 0.64279 0.76604 0.00000  0.00000 -2.50752 -1.28936 1.00000
