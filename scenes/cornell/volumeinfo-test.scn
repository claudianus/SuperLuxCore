# Volume Info.Flame -> Kelvin -> blackbody -> * flame mask -> emission
scene.textures.flameK.type = scale
scene.textures.flameK.texture1 = density
scene.textures.flameK.texture2 = 3000.0

scene.textures.firebb.type = blackbody
scene.textures.firebb.temperature = flameK
scene.textures.firebb.normalize = 1

scene.textures.emit.type = scale
scene.textures.emit.texture1 = firebb
scene.textures.emit.texture2 = density

scene.volumes.fire.type = heterogeneous
scene.volumes.fire.absorption = 0.0 0.0 0.0
scene.volumes.fire.scattering = scatter
scene.volumes.fire.asymmetry = 0.0 0.0 0.0
scene.volumes.fire.emission = emit
scene.volumes.fire.steps.size = 0.02
scene.volumes.fire.steps.maxcount = 256
scene.volumes.fire.multiscattering = 0
scene.volumes.fire.ior = 1.0

