# Dispersion caustic validation scene: Cornell box lit by a point light,
# a dispersive glass sphere on the floor. The spectral caustic under the
# sphere is reachable by light-path camera splats (L S+ D E) and by
# manifold connects: eye-side MNEE on the point light and light-side
# LMNEE where the camera view of the floor is blocked by the sphere.
# Spectral render only (path.spectral.enable = 1); under non-spectral
# transport the same scene still disperses through the u0-wavelength
# glass sampling branch.
scene.camera.type = "perspective"
scene.camera.lookat.orig = -2.78 -8. 2.73
scene.camera.lookat.target = -2.78 2. 2.73
scene.camera.fieldofview = 39.1463
################################################################################
scene.materials.Khaki.type = matte
scene.materials.Khaki.kd = 1. 0.824176 0.549451
scene.materials.HalveRed.type = matte
scene.materials.HalveRed.kd = 0.70003 0. 0.
scene.materials.DarkGreen.type = matte
scene.materials.DarkGreen.kd = 0. 0.4 0.
scene.materials.Grey.type = matte
scene.materials.Grey.kd = 0.75 0.75 0.75
scene.materials.glass.type = glass
scene.materials.glass.kt = 0.9 0.9 0.9
scene.materials.glass.kr = 0.9 0.9 0.9
scene.materials.glass.cauchyb = 0.25
################################################################################
scene.objects.Khaki.material = Khaki
scene.objects.Khaki.ply = scenes/cornell/Khaki.ply
scene.objects.HalveRed.material = HalveRed
scene.objects.HalveRed.ply = scenes/cornell/HalveRed.ply
scene.objects.DarkGreen.material = DarkGreen
scene.objects.DarkGreen.ply = scenes/cornell/DarkGreen.ply
scene.objects.Grey.material = Grey
scene.objects.Grey.ply = scenes/cornell/Grey.ply
scene.objects.sphere-mid.material = glass
scene.objects.sphere-mid.ply = scenes/cornell/sphere-mid.ply
################################################################################
scene.lights.l1.type = point
scene.lights.l1.position = -2.78 2.78 4.9
scene.lights.l1.gain = 35.0 35.0 35.0
