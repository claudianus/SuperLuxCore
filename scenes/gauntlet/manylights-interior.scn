# Gauntlet scene - "Manylights Interior".
#
# Sealed interior lit only by a field of 120 small emissive bulbs on a
# jittered 12x10 grid above the room, plus a very dim sky through the
# window. Exercises: light-sampling distribution quality, per-light
# shadow-ray cost, indirect dominance, no direct firefly help.
#
# Room x in [-7,7], y in [-1,15], z in [0,7].
scene.camera.lookat.orig = 6.2 12.8 3.4
scene.camera.lookat.target = -2.0 5.0 1.4
scene.camera.fieldofview = 52

################################################################################
scene.materials.walls.type = matte
scene.materials.walls.kd = 0.18 0.17 0.15
scene.materials.floor.type = roughmatte
scene.materials.floor.kd = 0.48 0.42 0.34
scene.materials.floor.sigma = 0.35
scene.materials.sofa.type = velvet
scene.materials.sofa.kd = 0.10 0.22 0.16
scene.materials.sofa.model = charlie
scene.materials.sofa.sheenroughness = 0.65
scene.materials.metal.type = metal2
scene.materials.metal.preset = aluminium
scene.materials.metal.distribution = ggx
scene.materials.metal.uroughness = 0.25
scene.materials.metal.vroughness = 0.25
# 3 bulb tints; each is a real emissive mesh light with its own group id
scene.materials.bulb.type = matte
scene.materials.bulb.kd = 0.9 0.9 0.9
scene.materials.bulb.emission = 34.0 30.0 22.0
scene.materials.bulb.emission.id = 0
scene.materials.bulb_c.type = matte
scene.materials.bulb_c.kd = 0.9 0.9 0.9
scene.materials.bulb_c.emission = 18.0 26.0 40.0
scene.materials.bulb_c.emission.id = 1
scene.materials.bulb_w.type = matte
scene.materials.bulb_w.kd = 0.9 0.9 0.9
scene.materials.bulb_w.emission = 44.0 30.0 14.0
scene.materials.bulb_w.emission.id = 2
################################################################################
scene.objects.room.material = walls
scene.objects.room.ply = scenes/gauntlet/mesh/room_portal.ply
scene.objects.floor.material = floor
scene.objects.floor.ply = scenes/gauntlet/mesh/floor_plane.ply
scene.objects.sofa.material = sofa
scene.objects.sofa.ply = scenes/gauntlet/mesh/slab.ply
scene.objects.sofa.transformation = 1.4 0.0 0.0 0.0  0.0 0.8 0.0 0.0  0.0 0.0 3.2 0.0  -2.0 5.0 0.0 1.0
scene.objects.orb.material = metal
scene.objects.orb.ply = scenes/gauntlet/mesh/orb.ply
scene.objects.orb.transformation = 0.8 0.0 0.0 0.0  0.0 0.8 0.0 0.0  0.0 0.0 0.8 0.0  -2.0 5.0 1.35 1.0

################################################################################
