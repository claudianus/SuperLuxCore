// Device-side port of luxrays/core/color/spectral.cpp (hero-wavelength
// spectral transport, 3 bins riding in float3 channels). Compiled only when
// the kernel is built with -D SLG_SPECTRAL; the data tables and helpers are
// unconditional so non-spectral builds are unaffected.
//
// Table data is mechanically extracted from
// include/luxrays/core/color/spds/data/{rgbE_32,rgbD65_32,xyzbasis}.h --
// the same source the CPU path samples, so CPU/GPU agree bit-for-data.

#define SLG_SPECTRAL_BINS 3
#define SLG_SPECTRAL_START 380.f
#define SLG_SPECTRAL_END 720.f
#define SLG_SPECTRAL_BIN_WIDTH ((SLG_SPECTRAL_END - SLG_SPECTRAL_START) / SLG_SPECTRAL_BINS)

// CIE table range (xyzbasis.h): CIEstart=360, CIEend=830, nCIE=471, 1nm step.
// The CPU RegularSPD bakes 683*(720-380)/4 into the samples; the same scale
// is applied here at sample time.
#define SLG_SPECTRAL_CIE_START 360.f
#define SLG_SPECTRAL_CIE_END 830.f
// 683 * (720-380) / 4
#define SLG_SPECTRAL_CIE_SCALE 58055.f
#define SLG_SPECTRAL_CIE_N 471

// Basis tables: 32 bins over 380-720nm (raw values, the *_scale factor is
// not applied -- spectral.cpp samples the raw arrays too).
#define SLG_SPECTRAL_BASIS_N 32
#define SLG_SPECTRAL_BASIS_START 380.f
#define SLG_SPECTRAL_BASIS_END 720.f

// spectralHeroAlive packing (HitPoint::spectralHeroAlive, SampleResult::spectralHeroAlive):
//   bits [0..2] aliveMask, bits [3..4] hero index
// The emission-eval context flag lives in HitPoint::spectralEmissionEval.
#define SLG_SW_ALIVE_MASK 0x7u
#define SLG_SW_HERO_SHIFT 3u
#define SLG_SW_HERO_MASK (0x3u << SLG_SW_HERO_SHIFT)
// hero=0, all alive
#define SLG_SW_DEFAULT (SLG_SW_ALIVE_MASK)

