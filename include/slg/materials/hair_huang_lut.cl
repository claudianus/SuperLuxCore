OPENCL_FORCE_INLINE float HairHuang_GlassE(const float mu, const float sqrtAlpha, const float eta) {
    const bool inv = eta < 1.f;
    const float z = sqrt(fabs((eta - 1.f) / (eta + 1.f)));
    __constant float *tab = inv ? kHairHuangGlassEInv_cl : kHairHuangGlassE_cl;
    const float fr = fmin(fmax(sqrtAlpha, 0.f), 1.f) * 16.f - 0.5f;
    const float fm = fmin(fmax(mu, 0.f), 1.f) * 16.f - 0.5f;
    const float fz = fmin(fmax(z, 0.f), 0.9999f) * 16.f - 0.5f;
    const int r0 = (int)fmin(fmax(floor(fr), 0.f), 14.f);
    const int m0 = (int)fmin(fmax(floor(fm), 0.f), 14.f);
    const int z0 = (int)fmin(fmax(floor(fz), 0.f), 14.f);
    const float tr = fmin(fmax(fr - r0, 0.f), 1.f);
    const float tm = fmin(fmax(fm - m0, 0.f), 1.f);
    const float tz = fmin(fmax(fz - z0, 0.f), 1.f);
    float c[2][2][2];
    for (int dr = 0; dr < 2; ++dr)
        for (int dm = 0; dm < 2; ++dm)
            for (int dz = 0; dz < 2; ++dz)
                c[dr][dm][dz] = tab[((r0 + dr) * 16 + (m0 + dm)) * 16 + (z0 + dz)];
    const float v00 = (1.f - tz) * c[0][0][0] + tz * c[0][0][1];
    const float v01 = (1.f - tz) * c[0][1][0] + tz * c[0][1][1];
    const float v10 = (1.f - tz) * c[1][0][0] + tz * c[1][0][1];
    const float v11 = (1.f - tz) * c[1][1][0] + tz * c[1][1][1];
    const float v0 = (1.f - tm) * v00 + tm * v01;
    const float v1 = (1.f - tm) * v10 + tm * v11;
    return (1.f - tr) * v0 + tr * v1;
}

