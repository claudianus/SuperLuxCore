//
// Temperature -> normalized RGB white point LUT, generated from
// luxrays::TemperatureToWhitePoint(t, normalize=true) over [800, 12000] K,
// N=160. Keep in sync with kBlackBodyRgbLut in slg/textures/blackbodylut.h.
//------------------------------------------------------------------------------

